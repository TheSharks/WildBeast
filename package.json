{
  "private": true,
  "name": "@thesharks/wildbeast",
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "update": "pnpm update -r -i"
  },
  "bugs": {
    "url": "https://github.com/TheSharks/WildBeast/issues"
  },
  "repository": "github:TheSharks/WildBeast",
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@changesets/cli": "^2.29.8",
    "turbo": "^2.7.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
