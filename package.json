{
  "private": true,
  "name": "@thesharks/wildbeast",
  "version": "0.0.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "update": "pnpm update -r -i",
    "test": "turbo run test",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "bugs": {
    "url": "https://github.com/TheSharks/WildBeast/issues"
  },
  "repository": "github:TheSharks/WildBeast",
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.10.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
