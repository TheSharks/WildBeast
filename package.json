{
  "private": true,
  "name": "@thesharks/wildbeast",
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{mts,tsx,md}\"",
    "update": "pnpm update -r -i"
  },
  "bugs": {
    "url": "https://github.com/TheSharks/WildBeast/issues"
  },
  "repository": "github:TheSharks/WildBeast",
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
