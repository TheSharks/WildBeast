          },
          "expr": "sum by (command) (rate(discord_context_command_errors_total{shard_id=~\"$shard\"}[$__rate_interval])) * 60",
          "legendFormat": "{{command}} (context)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Denied per minute by precondition",
      "description": "Which guard is rejecting users (Cooldown, UserPermissions, ...)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
