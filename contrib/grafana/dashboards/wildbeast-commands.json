    {
      "id": 27,
      "type": "timeseries",
      "title": "Gateway events per second (top 8 types)",
      "description": "Everything Discord pushes over the websocket; MESSAGE_CREATE and presence updates dominate on busy fleets",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none"
            },
