    {
      "id": 35,
      "type": "timeseries",
      "title": "Event loop delay p99 by worker",
      "description": "Sustained delay above 100ms means something synchronous is hogging the loop; the Sentry block watchdog fires at 1s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service_instance_id) (nodejs_eventloop_delay_p99_seconds)",
          "legendFormat": "shard {{service_instance_id}}",
          "refId": "A"
        }
      ]
    },
