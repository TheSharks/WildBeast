DATABASE_URL=postgres://postgres:postgres@db:5432/wildbeast
REDIS_HOST=redis
REDIS_PORT=6379

# Analytics - TimescaleDB (metrics) + Elasticsearch (logs)
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_LOGS_INDEX=wildbeast-logs-dev

# Retention policies (optional - uses defaults if not specified)
# METRICS_RETENTION_DAYS=730
# METRICS_COMPRESSION_DAYS=30
# LOGS_RETENTION_DAYS=365
# LOGS_COMPRESSION_DAYS=7

# Analytics behavior
METRICS_FLUSH_INTERVAL=30000
METRICS_BATCH_SIZE=100