{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "WildBeast",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers-extra/features/pnpm:2": {}
  },
  // String ports (schema requires strings; numbers are dropped): app forwards
  // the compose services' default ports — db 5432, redis 6379, otel 4317/4318.
  "forwardPorts": ["5432", "6379", "4317", "4318"],
  "portsAttributes": {
    "5432": { "label": "PostgreSQL" },
    "6379": { "label": "Redis" },
    "4317": { "label": "OTLP gRPC" },
    "4318": { "label": "OTLP HTTP" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "IronGeek.vscode-env",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "mzato0001.sapphire-i18n-ally"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
