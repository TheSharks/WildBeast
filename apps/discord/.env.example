# Standard configuration
# (All secrets below are fake placeholders. Unknown variables are ignored:
# only the names validated in src/env.mts take effect.)

# BOT_TOKEN is accepted as a legacy alias
DISCORD_TOKEN=your-bot-token-here
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# API keys

# SENTRY_DSN=https://ingress.sentry.io
# Continuous profiling session rate for shard workers, 0 to 1. Defaults to
# 0 (profiler off); the cluster manager never profiles.
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0

# Redis backs the task queue, identify throttling and gateway sessions, and
# is required even for a single cluster. Either a full URL (overrides the
# parts below) or the individual parts:
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=secret
# Logical database index, 0-15 (Redis default is 16 databases).
# REDIS_DB=0

# Advanced configuration

# WILDBEAST_INVITE_OVERRIDE=https://invite.thesharks.xyz
# Monetization SKU ids mapped to the premium tier they grant, optionally
# with the subscription kind the SKU is sold as (user or guild)
# WILDBEAST_PREMIUM_SKUS=1315790123456789:premium:user,1315790198765432:premium:guild
# OFREP-compatible service for command/task gates, experiments, and limits
# WILDBEAST_OFREP_URL=http://localhost:8016
# WILDBEAST_OFREP_TOKEN=secret
# WILDBEAST_OFREP_CACHE_TTL=30
# Stable identity of this cluster in the fleet. Defaults to
# hostname-pid (unique but unstable across restarts); production fleets
# should set an explicit stable id so restarts hash back to the same shards.
# WILDBEAST_CLUSTER_ID=main
# WILDBEAST_CLUSTERING_MODE=static
# WILDBEAST_SHARDING_START=0
# WILDBEAST_SHARDING_END=1
# WILDBEAST_SHARDING_TOTAL=2
# WILDBEAST_EPOCH is assigned by the cluster manager to shard workers in
# autonomous mode; never set it yourself.
