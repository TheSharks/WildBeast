  "name": "@thesharks/discord",
  "version": "9.0.0-dev",
  "main": "dist/index.mjs",
  "scripts": {
    "dev": "turbo build && concurrently \"npm:dev:*\"",
    "dev:watch": "tsc --watch",
    "dev:run": "npm run start",
    "start": "node dist/cluster.mjs",
    "start:worker": "node dist/main.mjs",
    "postbuild": "cp -r src/languages dist/languages",
    "build": "rimraf dist && tsc",
    "test": "vitest run"
  },
