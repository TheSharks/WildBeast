{
  "name": "@thesharks/tagscript",
  "version": "1.0.0",
  "description": "The TagScript templating language: a safe, limit-bounded interpreter for user-authored message templates, in Node and the browser",
  "keywords": [
    "tagscript",
    "jagtag",
    "template",
    "templating",
    "interpreter",
    "discord",
    "tags"
  ],
  "license": "MIT",
  "author": "Remco Jongschaap <hey@dougley.com>",
  "homepage": "https://wildbeast.guide/tagscript/overview/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSharks/WildBeast.git",
    "directory": "packages/tagscript"
  },
  "bugs": {
    "url": "https://github.com/TheSharks/WildBeast/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "dev": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": null
    },
    "./web": {
      "import": "./dist/web.js",
      "types": "./dist/web.d.ts",
      "require": null
    }
  },
  "devDependencies": {
    "@thesharks/tsconfig": "workspace:^",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "recheck": "^4.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
