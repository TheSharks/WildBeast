{
  "name": "@thesharks/analytics",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": null
    },
    "./register": {
      "import": "./dist/register.js",
      "types": "./dist/register.d.ts",
      "require": null
    },
    "./bridges/sapphire-logger": {
      "import": "./dist/bridges/sapphire-logger.js",
      "types": "./dist/bridges/sapphire-logger.d.ts",
      "require": null
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-fs": "^0.39.0",
    "@opentelemetry/instrumentation-ioredis": "^0.68.0",
    "@opentelemetry/instrumentation-pg": "^0.72.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.33.0",
    "@opentelemetry/instrumentation-undici": "^0.30.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@sapphire/framework": "^5.5.0",
    "@sapphire/pieces": "^4.3.1",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sentry/node": "^10.63.0",
    "@sentry/opentelemetry": "^10.63.0",
    "discord.js": "^14.26.4"
  },
  "devDependencies": {
    "@thesharks/test-utils": "workspace:^",
    "@thesharks/tsconfig": "workspace:^",
    "@types/node": "^26.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
