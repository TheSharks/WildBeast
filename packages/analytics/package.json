{
  "name": "@thesharks/analytics",
  "version": "1.0.0",
  "description": "Opinionated Sentry-on-OpenTelemetry telemetry bootstrap for Sapphire Discord bots: traces, metrics and logs over OTLP, with a Sapphire logger bridge",
  "keywords": [
    "opentelemetry",
    "otel",
    "sentry",
    "telemetry",
    "observability",
    "sapphire",
    "discord",
    "discord.js",
    "metrics",
    "tracing",
    "logging"
  ],
  "license": "MIT",
  "author": "Remco Jongschaap <hey@dougley.com>",
  "homepage": "https://wildbeast.guide/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheSharks/WildBeast.git",
    "directory": "packages/analytics"
  },
  "bugs": {
    "url": "https://github.com/TheSharks/WildBeast/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": null
    },
    "./register": {
      "import": "./dist/register.js",
      "types": "./dist/register.d.ts",
      "require": null
    },
    "./bridges/sapphire-logger": {
      "import": "./dist/bridges/sapphire-logger.js",
      "types": "./dist/bridges/sapphire-logger.d.ts",
      "require": null
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-fs": "^0.41.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sapphire/framework": "^5.5.1",
    "@sapphire/pieces": "^4.4.1",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sentry/node": "^10.74.0",
    "@sentry/node-native": "10.74.0",
    "@sentry/opentelemetry": "^10.74.0",
    "@sentry/profiling-node": "10.74.0",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@thesharks/test-utils": "workspace:^",
    "@thesharks/tsconfig": "workspace:^",
    "@types/node": "^26.5.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
